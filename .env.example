# ==========================================
# انسخ هذا الملف وسمّيه .env.local
# ==========================================

# Supabase - من https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT Secret (32 حرف على الأقل)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# Gmail SMTP
# 1. فعّل 2FA: myaccount.google.com/security
# 2. App Passwords: myaccount.google.com/apppasswords
# 3. أنشئ كلمة مرور للتطبيق "Employee Docs"
GMAIL_USER=yourcompany@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# معلومات الشركة
COMPANY_NAME=اسم شركتك

# URL الموقع
NEXT_PUBLIC_SITE_URL=http://localhost:3000
